/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    epicandi/epicandi Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null

    // ─── EpiCandi databases & references (overridable) ────────────────────
    sylph_db                   = null
    busco_lineage              = 'saccharomycetes_odb12'
    busco_downloads            = null
    refs_dir                   = null
    ref_manifest               = null
    amr_panel                  = null
    rosetta                    = null
    screen_bt2_index           = null
    screen_mmi                 = null
    phix_fa                    = null
    lambda_fa                  = null

    // ─── SNP-calling v2 (gatk4 architecture) ──────────────────────────────
    // Consolidated manifest (tag → fasta_path, mask_bed_path, ploidy, clade, …)
    refs_manifest              = "${projectDir}/assets/references_manifest.tsv"
    // Clair3 model directories (user-downloaded; one subdir per Dorado model)
    clair3_models_dir          = "${projectDir}/resources/databases/clair3_models"

    // HaplotypeCaller (Illumina/hybrid)
    // Defaults follow GATK recommendation (2 / 4) — sensible at ≥50× coverage.
    // Drop to 1/1 only when working with low-coverage cohorts (<20×).
    hc_min_pruning             = 2
    hc_min_dangling            = 4

    // Clair3 (Nanopore-only) — used when samplesheet.dorado_model is NA.
    // Available models (download from https://github.com/nanoporetech/rerio/tree/master/clair3_models
    // into clair3_models_dir; one subdir per model):
    //   r1041_e82_400bps_sup_v500   ← default. R10.4.1 MinION, sup-accuracy, Dorado v5.x.
    //                                  Recommended for modern (≥2023) nanopore data.
    //   r941_min_sup_g507           ← R9.4.1 MinION, sup-accuracy, guppy 5.0.7.
    //                                  Use for LEGACY R9 data (Albacore / early Guppy).
    //                                  Indel calls are unreliable on homopolymers; SNP F1 ~93-95%.
    //   r941_min_hac_g238           ← R9.4.1 MinION, hac, guppy 2.3.8. Closest to Albacore 2017
    //                                  but lower SNP F1; only consider if r941_min_sup_g507 fails.
    // For data of mixed vintage, set samplesheet.dorado_model per-sample with the
    // model subdir name; clair3_default_model is the fallback when that field is NA.
    clair3_default_model       = 'r1041_e82_400bps_sup_v500'
    clair3_include_all_ctgs    = true
    clair3_min_coverage        = 4
    clair3_min_dp              = 8
    clair3_min_qual            = 15
    clair3_max_missing_site    = 0.1

    // GATK genotype-level filters
    gatk_min_dp                = 10
    gatk_min_gq                = 30
    // "95% core" — drop sites with > 5% missing genotypes across the cohort.
    // Major lever for reducing spurious inter-sample SNPs.
    gatk_max_missing_site      = 0.05

    // SNP-distance QC
    snpdists_min_comparable_frac = 0.8

    // Epidemiology
    transmission_threshold_snps = 6
    cohort_min_samples         = 3

    // Phylogeny (IQ-TREE2)
    iqtree_model               = 'GTR+G+ASC'
    iqtree_bootstrap           = 1000
    iqtree_alrt                = 1000

    // Filtlong (SNP path: filter-only; assembly path: also adds --target_bases
    // computed dynamically per sample as genome_size_bp × target_coverage).
    filtlong_min_length        = 1000
    filtlong_min_mean_q        = 90

    // ─── Skip flags ──────────────────────────────────────────────────────
    skip_decont                = true
    skip_readscreen            = false
    // Skip the full GATK/Clair3 SNP-calling layer end-to-end (useful for asm-only runs).
    skip_snp_calling           = false
    // Skip the CNV layer (mosdepth + CNVkit + AMR↔CNV modulation). When OFF,
    // CNV depends on SNP_CALLING's dedup BAM — set skip_snp_calling=false too.
    skip_cnv                   = false

    // ─── CNV layer ───────────────────────────────────────────────────────
    cnv_panel                  = "${projectDir}/assets/cnv_loci/panel.tsv"
    cnv_coords_dir             = "${projectDir}/assets/cnv_loci/coords_pre"
    cnv_amr_rules              = "${projectDir}/assets/cnv_loci/cnv_amr_rules.tsv"
    cnv_canonical_proteins_dir = "${projectDir}/assets/cnv_loci/canonical_proteins"
    cnv_mutation_catalog       = "${projectDir}/assets/cnv_loci/mutation_catalog_auris.tsv"
    cnvkit_ploidy              = 1
    candida_genetic_code       = 12     // Yeast Alternative — CUG → Ser

    // ─── Step parameters (mirror v2 defaults) ────────────────────────────
    target_coverage            = 100
    subsample_seed             = 100
    illumina_min_len           = 50
    // TODO: switch default to 20 (NovaSeq de-facto standard) once the SNP
    // re-run experiment is complete; kept at 25 for now to preserve cache.
    illumina_min_qual          = 25
    nanopore_min_len           = 1000
    nanopore_min_qual          = 10
    read_screen_n_illu         = 100000
    read_screen_n_nano         = 10000
    qc_min_reads               = 1000000
    qc_warn_reads              = 100000
    qc_max_contam              = 30
    qc_warn_contam             = 10
    // ─── QC GATE v2 (5 criterios AND, post-IDENTIFICATION) ───────────────
    qc_min_ani                 = 97       // Sylph Adjusted_ANI for the assigned species (%)
    qc_min_sylph_cov           = 85       // Sylph taxonomic abundance for the assigned species (%)
    qc_min_align_rate          = 90       // % of read_screen reads aligned to the winning ref
    qc_min_depth               = 30       // estimated mean depth (×) on the winning ref
    asm_minlen                 = 500
    spades_mem_gb              = 32
    ani_high_conf              = 97.0
    ani_low_conf               = 95.0
    readscreen_pct_top         = 85.0
    readscreen_pct_unmapped_max = 50.0
    phylo_min_samples          = 3

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        // nmquijada hosts ChroQueTaS (no Bioconda package available)
        conda.channels          = ['conda-forge', 'bioconda', 'nmquijada']
        // Persist env directories outside work/ so they survive `rm -rf work`.
        conda.cacheDir          = "${projectDir}/.conda"
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.cacheDir          = "${projectDir}/.conda"
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
    hpc       { includeConfig 'conf/hpc.config'       }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load epicandi/epicandi custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile.
// Not used unless one of those engines is enabled.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'epicandi/epicandi'
    contributors    = [
        [
            name: 'Alejandro Sanz-Carbonell',
            affiliation: 'FISABIO / IIS La Fe',
            email: 'alexsanzc@gmail.com',
            github: 'alexsanzc',
            contribution: ['author', 'maintainer'],
            orcid: '0000-0002-1969-5557'
        ],
    ]
    homePage        = 'https://github.com/epicandi/epicandi'
    description     = """EpiCandi v2 — Candida spp QC/Assembly/AMR/Phylogeny pipeline"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// nf-schema 2.5.1: plugin auto-discovers nextflow_schema.json; no validation{} block needed.
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
