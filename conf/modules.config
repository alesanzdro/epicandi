/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-module options + publish paths.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    `ext.args`/`ext.prefix` are mirrored from the standalone v2 step scripts so
    behavioural parity with the bash pipeline is one diff away.

    Output layout (numbered by pipeline stage; samples nested inside):
       01_qc/<sample>/              FastQC raw/clean + nanoplot + fastp + qc_flag
       02_subsample/<sample>/       seqtk (illu) + filtlong (nano)
       03_identification/<sample>/  sylph + auriclass + species_call
       04_assembly/<sample>/        SPAdes/Flye/Hybrid → .fasta + intermediates
       05_post_asm_qc/<sample>/     quast + busco
       06_amr/<sample>/             chroquetas + resistance_report
       07_snp/refs/<reference_tag>/ reference fasta + indexes + mask
       07_snp/bams/<sample>/        dedup BAM (Illu/Hybrid) + raw BAM (nano)
       07_snp/gvcf/<sample>/        gVCF (HaplotypeCaller / Clair3)
       07_snp/joint/<cohort>/       joint genotyping (CombineGVCFs+GenotypeGVCFs)
       07_snp/filtered/<cohort>/    filtered SNPs
       07_snp/alignment/<cohort>/   vcf2phylip
       07_snp/snpdists/<cohort>/    pairwise SNP distance matrix
       07_snp/phylogeny/<cohort>/   IQ-TREE
       07_snp/network/<cohort>/     UPGMA network
       08_cnv/<sample>/             mosdepth + cnvkit + extract + atlas
       08_cnv/aggregated/           cohort matrices + coverage_tracks
       cohort/                      BUILD_MASTER_TABLE (call_matrix, master_table)
       multiqc/                     MultiQC report
       pipeline_info/               Nextflow execution traces
----------------------------------------------------------------------------------------
*/

process {

    // Default: hidden — every named publishDir below decides where to publish.
    publishDir = [ enabled: false ]

    // ─── 01_qc — raw + clean QC, fastp/porechop/chopper, qc_gate ──────────
    withName: 'FASTQ_QC_RAW:FASTQC' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}.raw" }
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/fastqc_raw" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTQ_QC_RAW:NANOPLOT' {
        ext.prefix = { "${meta.id}.raw" }
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/nanoplot_raw" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTQ_QC_CLEAN:FASTQC' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/fastqc_clean" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTQ_QC_CLEAN:NANOPLOT' {
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/nanoplot_clean" }, mode: params.publish_dir_mode ]
    }
    withName: 'FASTP' {
        ext.args = { "--length_required ${params.illumina_min_len} " +
                     "--qualified_quality_phred ${params.illumina_min_qual} " +
                     "--cut_tail --cut_tail_window_size 4 --cut_tail_mean_quality 20 " +
                     "--trim_poly_g" }
        ext.prefix = { "${meta.id}.trim" }
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/fastp" }, mode: params.publish_dir_mode ]
    }
    withName: 'PORECHOP_ABI' {
        ext.prefix = { "${meta.id}.porechop_abi" }
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/porechop_chopper" }, mode: params.publish_dir_mode ]
    }
    withName: 'CHOPPER' {
        ext.args2  = { "--quality ${params.nanopore_min_qual} --minlength ${params.nanopore_min_len}" }
        ext.prefix = { "${meta.id}.clean" }
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/porechop_chopper" }, mode: params.publish_dir_mode ]
    }
    withName: 'QC_GATE' {
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ─── 03_identification ──────────────────────────────────────────────────
    withName: 'SYLPH_PROFILE' {
        ext.args   = '-u'
        ext.prefix = { "${meta.id}.sylph" }
        publishDir = [ path: { "${params.outdir}/03_identification/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    // NOTE: drop the 'IDENTIFICATION:' prefix — Nextflow 25.10's resolver
    // misses the closure form of ext.args when the selector carries a
    // subworkflow namespace. The process names below are unique pipeline-wide.
    withName: 'SEQKIT_SAMPLE_PAIR' {
        ext.args   = { "-s 42 -n ${params.read_screen_n_illu}" }
        ext.prefix = { "${meta.id}.rs_illu" }
        publishDir = [ enabled: false ]
    }
    // Real process name is SEQKIT_SAMPLE (nf-core); we only invoke it once
    // (with alias SEQKIT_SAMPLE_NANO) so matching by base name is unambiguous.
    withName: 'SEQKIT_SAMPLE' {
        ext.args   = { "-s 42 -n ${params.read_screen_n_nano}" }
        ext.prefix = { "${meta.id}.rs_nano" }
        publishDir = [ enabled: false ]
    }
    withName: 'BOWTIE2_ALIGN' {
        // bowtie2 --no-unal already drops unmapped reads before the sort;
        // ext.args2 is piped to `samtools sort` (not `view`), which does not
        // support -F, so we keep args2 unset.
        ext.args  = '--very-sensitive -k 1 --no-unal'
        ext.prefix = { "${meta.id}.screen" }
        publishDir = [ enabled: false ]
    }
    withName: 'MINIMAP2_ALIGN' {
        ext.args   = '-x map-ont'
        ext.prefix = { "${meta.id}.screen_nano" }
        publishDir = [ enabled: false ]
    }
    withName: 'IDENTIFICATION:TALLY_ILLU' {
        publishDir = [ path: { "${params.outdir}/03_identification/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'IDENTIFICATION:TALLY_NANO' {
        publishDir = [ path: { "${params.outdir}/03_identification/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'AURICLASS' {
        publishDir = [ path: { "${params.outdir}/03_identification/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SPECIES_CALL' {
        publishDir = [ path: { "${params.outdir}/03_identification/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ─── PREPARE_SCREEN_DB (one-time, shared) ────────────────────────────
    withName: 'SCREEN_FASTA' {
        publishDir = [ path: { "${params.outdir}/_db/screen" }, mode: params.publish_dir_mode ]
    }
    withName: 'BOWTIE2_BUILD' {
        publishDir = [ path: { "${params.outdir}/_db/screen" }, mode: params.publish_dir_mode ]
    }
    withName: 'MINIMAP2_INDEX' {
        publishDir = [ path: { "${params.outdir}/_db/screen" }, mode: params.publish_dir_mode ]
    }

    // ─── 02_subsample ────────────────────────────────────────────────────
    withName: 'SUBSAMPLE_SWF:SUBSAMPLE_ILLU' {
        publishDir = [ path: { "${params.outdir}/02_subsample/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SUBSAMPLE_SWF:SUBSAMPLE_NANO' {
        publishDir = [ path: { "${params.outdir}/02_subsample/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'FILTLONG_ASM' {
        ext.args   = { "--target_bases ${meta.target_bases}" }
        ext.prefix = { "${meta.id}.filt" }
        publishDir = [ path: { "${params.outdir}/02_subsample/${meta.id}" }, mode: params.publish_dir_mode, pattern: '*.json' ]
    }

    // ─── 04_assembly ─────────────────────────────────────────────────────
    withName: 'SPADES' {
        ext.args   = '--isolate --cov-cutoff auto'
        ext.prefix = { "${meta.id}.spades" }
        publishDir = [ path: { "${params.outdir}/04_assembly/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'FLYE' {
        ext.args   = '-g 12500000'
        ext.prefix = { "${meta.id}.flye" }
        publishDir = [ path: { "${params.outdir}/04_assembly/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'MEDAKA' {
        ext.args   = { meta.dorado_model && meta.dorado_model != 'NA' ? "-m ${meta.dorado_model}" : '' }
        ext.prefix = { "${meta.id}.medaka" }
        publishDir = [ path: { "${params.outdir}/04_assembly/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'POLYPOLISH' {
        publishDir = [ path: { "${params.outdir}/04_assembly/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'PYPOLCA' {
        publishDir = [ path: { "${params.outdir}/04_assembly/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'ASM_FINALIZE' {
        publishDir = [ path: { "${params.outdir}/04_assembly/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ─── 05_post_asm_qc ──────────────────────────────────────────────────
    withName: 'QUAST' {
        ext.args   = '--fungus'
        ext.prefix = { "${meta.id}.quast" }
        publishDir = [ path: { "${params.outdir}/05_post_asm_qc/${meta.id}/quast" }, mode: params.publish_dir_mode ]
    }
    withName: 'BUSCO_BUSCO' {
        ext.args   = '--offline --force'
        ext.prefix = { "${meta.id}.busco" }
        publishDir = [ path: { "${params.outdir}/05_post_asm_qc/${meta.id}/busco" }, mode: params.publish_dir_mode ]
    }

    // ─── 06_amr ─────────────────────────────────────────────────────────
    withName: 'CHROQUETAS' {
        publishDir = [ path: { "${params.outdir}/06_amr/${meta.id}/chroquetas" }, mode: params.publish_dir_mode ]
    }
    withName: 'CHROQUETAS_JOIN' {
        publishDir = [ path: { "${params.outdir}/06_amr/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ─── 07_snp — variant calling layer ──────────────────────────────────
    withName: 'PREPARE_REFERENCE' {
        publishDir = [ path: { "${params.outdir}/07_snp/refs/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'FILTLONG_SNP' {
        publishDir = [ path: { "${params.outdir}/01_qc/${meta.id}/filtlong_snp" }, mode: params.publish_dir_mode, pattern: '*.json' ]
    }
    withName: 'BWAMEM2_MEM' {
        ext.args   = { "-R \"@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA\\tLB:${meta.id}\\tPU:${meta.batch ?: 'na'}\" -M" }
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ enabled: false ]
    }
    withName: 'GATK4_MARKDUPLICATES' {
        ext.args   = '--CREATE_INDEX true'
        ext.prefix = { "${meta.id}.dedup.bam" }
        publishDir = [ path: { "${params.outdir}/07_snp/bams/${meta.id}" }, mode: params.publish_dir_mode ]
        // The upstream nf-core module is labelled process_low (2 cpus, 12 GB).
        // For a 12 MB Candida sorted BAM that's tight — bumping to 4 cpus +
        // 16 GB cuts wall-time by ~40 % on smoke data without crowding the
        // node.  Scales linearly with task.attempt if it ever has to retry.
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
    }
    withName: 'MINIMAP2_ONT' {
        publishDir = [ path: { "${params.outdir}/07_snp/bams/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK4_HAPLOTYPECALLER' {
        ext.args   = { "--emit-ref-confidence GVCF --sample-ploidy ${meta.ploidy} --min-pruning ${params.hc_min_pruning} --min-dangling-branch-length ${params.hc_min_dangling}" }
        ext.prefix = { "${meta.id}.g" }
        publishDir = [ path: { "${params.outdir}/07_snp/gvcf/${meta.id}" }, mode: params.publish_dir_mode ]
        // Pair-HMM is the inner loop that benefits from threads, and it
        // saturates around 4-6.  Beyond that the gains are <10 % and you just
        // crowd out other concurrent tasks (SPAdes, BUSCO, ...).  4 cpus is
        // the sweet spot for haploid Candida; 16 GB heap fits the GATK
        // recommendation of >= -Xmx10G for HC.
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
    }
    withName: 'CLAIR3' {
        publishDir = [ path: { "${params.outdir}/07_snp/gvcf/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK4_COMBINEGVCFS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }
    withName: 'GATK4_GENOTYPEGVCFS' {
        ext.prefix = { "${meta.id}.joint" }
        publishDir = [ path: { "${params.outdir}/07_snp/joint/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'GATK_FILTER_SNPS' {
        publishDir = [ path: { "${params.outdir}/07_snp/filtered/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'VCF2PHYLIP' {
        publishDir = [ path: { "${params.outdir}/07_snp/alignment/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SNPDISTS_MATRIX' {
        ext.args   = '-c'
        ext.prefix = { "${meta.id}.snpdist" }
        publishDir = [ path: { "${params.outdir}/07_snp/snpdists/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'SNPDISTS_MOLTEN' {
        ext.args   = '-c -m'
        ext.prefix = { "${meta.id}.snpdist.molten" }
        publishDir = [ path: { "${params.outdir}/07_snp/snpdists/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'IQTREE' {
        ext.args   = { "-m ${params.iqtree_model} -B ${params.iqtree_bootstrap} -alrt ${params.iqtree_alrt} -st DNA" }
        publishDir = [ path: { "${params.outdir}/07_snp/phylogeny/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'UPGMA_NETWORK' {
        publishDir = [ path: { "${params.outdir}/07_snp/network/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ─── 08_cnv ─────────────────────────────────────────────────────────
    withName: 'MOSDEPTH' {
        ext.args   = '--no-per-base --fast-mode --mapq 30'
        publishDir = [ path: { "${params.outdir}/08_cnv/${meta.id}/mosdepth" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNV_DETECT' {
        publishDir = [ path: { "${params.outdir}/08_cnv/${meta.id}" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNVKIT_REFERENCE' {
        publishDir = [ path: { "${params.outdir}/08_cnv/_cnvkit_reference" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNVKIT_BATCH' {
        publishDir = [ path: { "${params.outdir}/08_cnv/${meta.id}/cnvkit" }, mode: params.publish_dir_mode ]
    }
    withName: 'COVERAGE_TRACKS' {
        ext.args   = '--only_events --padding_bp 15000'
        publishDir = [ path: { "${params.outdir}/08_cnv/aggregated" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNV_AGGREGATE' {
        // Module emits everything inside aggregated/ — publishDir points one level up.
        publishDir = [ path: { "${params.outdir}/08_cnv" }, mode: params.publish_dir_mode ]
    }
    withName: 'EXTRACT_GENE_PROTEINS' {
        publishDir = [ path: { "${params.outdir}/08_cnv/${meta.id}/gene_proteins" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNV_AMR_ATLAS' {
        // Module emits everything inside atlas/ — publishDir points one level up.
        publishDir = [ path: { "${params.outdir}/08_cnv/${meta.id}" }, mode: params.publish_dir_mode ]
    }

    // ─── cohort / multiqc ───────────────────────────────────────────────
    withName: 'BUILD_MASTER_TABLE' {
        publishDir = [ path: { "${params.outdir}/cohort" }, mode: params.publish_dir_mode ]
    }
    withName: 'PLOT_AMR_HEATMAP' {
        publishDir = [ path: { "${params.outdir}/cohort" }, mode: params.publish_dir_mode ]
    }
    withName: 'CNV_VISUALIZATION' {
        publishDir = [ path: { "${params.outdir}/08_cnv/aggregated/plots" }, mode: params.publish_dir_mode ]
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path:   { "${params.outdir}/multiqc" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
