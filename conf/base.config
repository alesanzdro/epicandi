/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    epicandi/epicandi Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default resources per process label.  Each profile (test, hpc, run96…)
    sets the per-host `resourceLimits`; Nextflow then fits tasks in parallel
    up to that ceiling.

    ─── Scaling philosophy ─────────────────────────────────────────────────
    Two layers control per-task resources:

      1.  The label tier (here)         — sets a sensible ceiling per task
          process_single  =  1 cpu   /   6 GB
          process_low     =  2 cpus  /  12 GB
          process_medium  =  6 cpus  /  36 GB
          process_high    = 12 cpus  /  72 GB

      2.  Per-process overrides in conf/modules.config (withName:) — used to
          tune individual tools that scale poorly past 4-6 threads (GATK4
          HaplotypeCaller, MarkDuplicates), or that need a memory bump.

    Tools that diminish past 4-6 threads (HaplotypeCaller, MarkDuplicates)
    are capped via `withName:` overrides in modules.config, so spare cores
    are free for the next sample's parallel HC, SPAdes, BUSCO, etc.

    Tools that scale linearly (BWA-MEM2, SPAdes, minimap2, samtools sort,
    Polypolish) keep `process_high` (12 cpus) so they saturate cleanly on
    bigger machines.

    ─── Sensible `resourceLimits` per host class ───────────────────────────
       16-core node  →  resourceLimits = [ cpus: 16, memory:  64.GB ]
       24-core node  →  resourceLimits = [ cpus: 24, memory:  96.GB ]
       32-core node  →  resourceLimits = [ cpus: 32, memory: 128.GB ]
       64-core fat   →  resourceLimits = [ cpus: 64, memory: 256.GB ]

    On a 32+ core machine the labels above still cap any single task at
    12 cpus — what scales is the *parallelism between samples*, which is
    exactly what you want for a cohort run.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process labels — reused from nf-core/modules conventions.
    // Per-process overrides live in conf/modules.config (CHECKPOINT C/D).
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}
