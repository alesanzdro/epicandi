/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    96-thread cohort override
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pin the local executor to 96 CPUs / 400 GB RAM (fat node Heimdal),
    cap any single process at 16 cpus / 64 GB so the scheduler can fit
    ~6 heavy procs (bwa-mem2, GATK HC, SPAdes, …) concurrently — better
    throughput for 126 Illumina-only samples than letting one process
    monopolise the node.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus:   16,
        memory: '64.GB',
        time:   '48.h'
    ]
}

executor {
    name   = 'local'
    cpus   = 96
    memory = '400.GB'
}
