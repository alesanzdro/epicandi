/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests (smoke test)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Single C. auris sample (Illumina-only by default — see assets/samplesheet.csv).
    Reaches POST_ASM_QC + AMR + per-sample variant calling.  Cohort SNP +
    phylogeny is automatically skipped when n_samples < cohort_min_samples (3).

    Usage:
        nextflow run epicandi/epicandi -profile test,conda --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 16,
        memory: '64.GB',
        time: '12.h'
    ]
}

params {
    config_profile_name        = 'Smoke test profile'
    config_profile_description = 'Minimal single-sample C. auris run for smoke validation'

    // MultiQC chokes on ANSI escape codes that nf-core utils inject when
    // monochrome_logs is false — force-disable colour in the summary plumbing.
    monochrome_logs            = true

    input = "${projectDir}/assets/samplesheet.csv"

    // ──────────────────────────────────────────────────────────────────────
    // Self-contained assets shipped inside the repo (small files only).
    // ──────────────────────────────────────────────────────────────────────
    refs_dir          = "${projectDir}/resources/references"
    ref_manifest      = "${projectDir}/resources/references/ref_candida_info.tsv"
    amr_panel         = "${projectDir}/assets/amr_db/epicandi_AMR_panel_unique.tsv"
    rosetta           = "${projectDir}/assets/amr_db/candida_rosetta_v2.tsv"

    // ──────────────────────────────────────────────────────────────────────
    // Heavy databases — assumed present at a known Heimdal/Gru location.
    // Override at runtime with --sylph_db / --busco_downloads if different.
    // ──────────────────────────────────────────────────────────────────────
    sylph_db          = '/home/asanzc/epicandi_databases/sylph/sketches/epicandi.syldb'
    busco_downloads   = '/home/asanzc/epicandi/resources/busco_downloads'

    // Skip flags (smoke defaults: skip decont and read_screen — single sample)
    skip_decont       = true
    skip_readscreen   = true
    // SNP calling runs through HaplotypeCaller; cohort joint-genotyping skips
    // automatically when n_samples < cohort_min_samples (warn, not fail).
    skip_snp_calling  = false
}
