/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile for Heimdal/Gru HPC nodes — local executor, parametrizable.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defaults assume a fat node (64 cores / 256 GB). Override per host via
    --max_cpus / --max_memory / --max_time at runtime.

    Switch executor to slurm by overriding `process.executor` from a private
    institutional config — kept local here so this lints out of the box.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'local'
    resourceLimits = [
        cpus:   16,
        memory: '128.GB',
        time:   '48.h'
    ]
}

params {
    config_profile_name        = 'HPC node profile'
    config_profile_description = 'Local executor on a Heimdal/Gru fat node — parametrizable'
}

// Conda env cache.  Default keeps envs inside the pipeline dir so different
// pipelines can have isolated solves.  Override at runtime with
// `--conda_cache_dir /shared/conda-envs` (or via env $NXF_CONDA_CACHEDIR) to
// share solves across pipelines.
conda.cacheDir = params.conda_cache_dir ?: "${projectDir}/.conda_envs"
